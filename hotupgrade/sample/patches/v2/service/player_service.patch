--- 把现存 PlayerService 的状态和 load 函数更新为 V2。
return function(state)
    return
    {
        migrate = function(old_state)
            if old_state.schema_version ~= 1 then
                error("PlayerService 只支持从 schema 1 迁移")
            end

            return
            {
                equip = "剑",
                level = old_state.level,
                schema_version = 2,
            }
        end,
        functions =
        {
            load = function(base_attack)
                return base_attack + (state.equip == "剑" and 20 or 0)
            end,
        },
    }
end
