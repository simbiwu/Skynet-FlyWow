+-- 逻辑唯一键仍由原生 service_mgr 注册表管理，只有实际入口改为 Bootstrap。
+function cmd.MANAGED_LAUNCH(name, controller_handle, creation_id, arguments, allow_create)
+	local realname = read_name(name)
+	local key = realname == "snaxd" and name .. "." .. assert(arguments[1]) or name
+	local reservation = managed_services[key]
+	local existing = service[key]
+	if existing ~= nil and not reservation and (type(existing) ~= "table" or existing.launch) then
+		return {ok = false, code = "HU_UNIQUE_UNMANAGED", message = "唯一名已由非受管理入口占用"}
+	end
+
+	local created = false
+	if not reservation then
+		local preload = skynet.getenv("preload")
+		if preload and preload ~= "" then
+			return {ok = false, code = "HU_PRELOAD_UNSUPPORTED", message = "实际启动节点存在非空 preload"}
+		end
+		if not allow_create then
+			return {ok = false, code = "HU_TARGET_LIMIT", message = "Controller 创建容量不足"}
+		end
+		reservation = {controller_handle = controller_handle, creation_id = creation_id}
+		managed_services[key] = reservation
+		service[key] = existing or {}
+		service[key].managed = true
+		created = true
+	end
+
+	local function launch()
+		if realname ~= "snaxd" then
+			return skynet.newservice("flywow_hotupgrade_bootstrap", reservation.controller_handle,
+				reservation.creation_id, realname, table.unpack(arguments, 1, arguments.n))
+		end
+		-- snaxd 唯一键包含子名；init 参数仍通过原生 snax 协议交付。
+		local interface = snax.interface(arguments[1])
+		local handle = skynet.newservice("flywow_hotupgrade_bootstrap", reservation.controller_handle,
+			reservation.creation_id, realname, arguments[1])
+		if interface.system.init then
+			local ok, message = pcall(skynet.call, handle, "snax", interface.system.init,
+				table.unpack(arguments, 2, arguments.n))
+			if not ok then
+				skynet.kill(handle)
+				error(tostring(message))
+			end
+		end
+		return handle
+	end
+
+	local ok, handle = pcall(waitfor, key, created and launch or nil)
+	if not ok then
+		if managed_services[key] == reservation then
+			managed_services[key] = nil
+		end
+		error(tostring(handle))
+	end
+	return {handle = handle, controller_handle = reservation.controller_handle, creation_id = reservation.creation_id}
+end
+
+function cmd.MANAGED_RELEASE(name, handle, controller_handle, subname, creation_id)
+	local key = read_name(name) == "snaxd" and name .. "." .. assert(subname) or name
+	local reservation = managed_services[key]
+	-- 迟到确认不得终止同一逻辑键后续创建的 Service。
+	if not reservation or reservation.creation_id ~= creation_id then
+		return true
+	end
+	if reservation.controller_handle ~= controller_handle or service[key] ~= handle then
+		error("HU_UNIQUE_RELEASE_MISMATCH: 唯一名、handle 或 Controller 不匹配")
+	end
+	skynet.kill(handle)
+	service[key] = nil
+	managed_services[key] = nil
+	return true
