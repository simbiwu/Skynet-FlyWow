return function(state)
    return
    {
        update_state = function()
            assert(state.schema_version == 1, "PlayerService 需要 schema 1")
            state.equip = "剑"
            state.schema_version = 2
        end,
        replace_functions =
        {
            load = function(base_attack)
                if state.equip == "剑" then
                    return base_attack + 20 + 1
                end

                return base_attack
            end,
        },
    }
end
